# ==============================================================================
# FitNexus Fullstack Gym - Docker Compose Environment Configuration Template
# Copy this file to .env and configure your variables before running:
#   docker compose up --build
# ==============================================================================

# --- MySQL Configuration ---
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=gms
MYSQL_USER=gms_user
MYSQL_PASSWORD=your_mysql_user_password

# --- Backend Database Connection (Inside Docker Network) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=gms
DB_USERNAME=gms_user
DB_PASSWORD=your_mysql_user_password

# --- Backend Server Configuration ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend Configuration (Browser Facing) ---
# Note: This is consumed by the user's browser, so localhost:8080 is used.
NEXT_PUBLIC_API_URL=http://localhost:8080/api
FRONTEND_PORT=3000
